// ═══════════════════════════════════════════════════════════════════════
//  TRAILER-LOAD — PRIVATE TEST SUITE
//  F-Keys Creative LLC
//
//  This deploys the WHOLE SITE to the lab worker at its own test address,
//  completely separate from production.
//
//  Production is the static host, serving the `main` branch at
//  www.trailer-load.com. Nothing in this folder can reach it. There is no
//  shared pipeline, no shared host, and no shared DNS record.
//
//  Deploy from the repo root:   npx wrangler deploy -c .staging/wrangler.jsonc
// ═══════════════════════════════════════════════════════════════════════
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trailer-load-lab",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",

  // Serve the repository root as static assets. Paths are relative to THIS
  // file, so ".." is the repo root.
  "assets": {
    "directory": "..",
    "binding": "ASSETS",

    // The production host serves "/lock-in.html" literally. The worker asset server
    // defaults to "auto-trailing-slash", which 307-redirects that to
    // "/lock-in" and breaks every .html link in the product. "none" makes the
    // lab byte-match production routing, which is the entire point of a lab.
    "html_handling": "none",
    "not_found_handling": "404-page",

    // Without this, a matching asset is returned BEFORE worker.js runs, so the
    // robots override and the noindex header never fire. Measured: the first
    // deploy served the live permissive robots.txt and no X-Robots-Tag at all.
    "run_worker_first": true
  },

  // Never let the lab build be indexed, and never let it be mistaken for
  // the live site. worker.js reads these.
  "vars": {
    "LAB": "1",
    "LAB_LABEL": "TEST SUITE, NOT PRODUCTION",
    // the LOCK IN API (api/lockin-api.js) reads and writes only the lab_ tables; production's are li_
    "TABLE_PREFIX": "lab_"
  },

  // The LOCK IN database. One database holds the sandbox (lab_) and production (li_) tables, because the free plan
  // allows 10 databases and the account already had 9. With no email sender set, the API writes every email to the
  // lab_outbox table instead, so the sandbox can test every link without sending anything.
  "d1_databases": [
    { "binding": "DB", "database_name": "trailer-load", "database_id": "99fcb75d-64d0-4d8d-bc6f-31843eaf10b1" }
  ],

  "observability": { "enabled": true }
}
